{
	"name": "@pentatonic-dev/n8n-nodes-notifuse",
	"version": "1.5.0",
	"description": "n8n nodes for Notifuse - transactional email and newsletter management platform",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"nodes",
		"notifuse",
		"email",
		"newsletter",
		"transactional",
		"webhook"
	],
	"private": false,
	"license": "MIT",
	"author": {
		"name": "Pentatonic",
		"email": "hello@pentatonic.dev"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PentatonicDev/n8n-nodes-notifuse.git"
	},
	"engines": {
		"node": ">=22"
	},
	"main": "index.js",
	"scripts": {
		"build": "npx rimraf dist && tsc && gulp build:icons",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "eslint nodes credentials",
		"lintfix": "eslint nodes credentials --fix",
		"test": "jest",
		"prepublishOnly": "npm run build && npm run lint"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/NotifuseApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Notifuse/Notifuse.node.js",
			"dist/nodes/NotifuseTrigger/NotifuseTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/eslint-plugin-community-nodes": "^0.19.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^25.0.3",
		"eslint": "^10.0.0",
		"gulp": "^5.0.1",
		"gulp-rename": "^2.0.0",
		"gulp-svgmin": "^4.1.0",
		"jest": "^30.1.3",
		"n8n-workflow": "*",
		"prettier": "^3.0.0",
		"ts-jest": "^29.4.6",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.57.0"
	},
	"dependencies": {
		"isbot": "^5.1.36"
	},
	"overrides": {
		"form-data": "^4.0.4"
	},
	"publishConfig": {
		"access": "public"
	}
}
